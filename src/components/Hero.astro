---
import { siteMeta, type Locale, copy } from '../content/site';

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
const t = copy[locale];
---

<section class="hero" id="content">
  <div class="hero-grid site-shell">
    <div class="copy">
      <p class="role"><span aria-hidden="true"></span>{t.hero.role}</p>
      <h1>{t.hero.lead}</h1>
      <p class="support">{t.hero.support}</p>
      <div class="actions">
        <a class="btn btn-signal" href="#work">{t.hero.ctaWork}<span aria-hidden="true">↓</span></a>
        <a class="text-link" href={siteMeta.github} target="_blank" rel="noopener noreferrer">
          {t.hero.ctaGithub}<span aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

    <figure class="visual">
      <div class="visual-frame">
        <video autoplay muted loop playsinline preload="metadata" aria-label={t.hero.mediaCaption}>
          <source src="/media/vision-teleop.mp4" type="video/mp4" />
        </video>
        <div class="scanline" aria-hidden="true"></div>
        <p class="frame-label"><span>LIVE</span> VISION / ARM TELEOP</p>
        <p class="frame-counter">01—04</p>
      </div>
      <figcaption>
        <span>{t.hero.mediaCaption}</span>
        <span>2026 / SELECTED WORK</span>
      </figcaption>
    </figure>
  </div>

  <div class="pipeline site-shell" aria-label={locale === 'zh' ? '系统信号' : 'System signals'}>
    {
      t.hero.signals.map((signal, index) => (
        <div class="pipeline-step">
          <span>{String(index + 1).padStart(2, '0')}</span>
          <strong>{signal.value}</strong>
          <p>{signal.label}</p>
        </div>
      ))
    }
  </div>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    min-height: min(940px, 100svh);
    padding: clamp(7.5rem, 14vh, 10rem) 0 0;
    color: var(--paper);
    background:
      radial-gradient(circle at 78% 30%, rgba(212, 242, 92, 0.08), transparent 24rem),
      linear-gradient(rgba(245, 244, 237, 0.035) 1px, transparent 1px),
      linear-gradient(90deg, rgba(245, 244, 237, 0.035) 1px, transparent 1px),
      var(--dark);
    background-size: auto, 68px 68px, 68px 68px, auto;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(420px, 1.08fr);
    align-items: center;
    gap: clamp(3rem, 7vw, 7rem);
  }

  .copy {
    animation: rise 850ms var(--ease) both;
  }

  .role {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    margin: 0;
    color: var(--signal);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  .role span {
    width: 1.7rem;
    height: 1px;
    background: currentColor;
  }

  h1 {
    max-width: 12ch;
    margin: 1.3rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(3rem, 5.7vw, 5.8rem);
    font-weight: 720;
    letter-spacing: -0.065em;
    line-height: 0.98;
    text-wrap: balance;
  }

  .support {
    max-width: 31rem;
    margin: 1.6rem 0 0;
    color: var(--paper-muted);
    font-size: clamp(1rem, 1.4vw, 1.15rem);
  }

  .actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1.4rem;
    margin-top: 2.2rem;
  }

  .btn-signal {
    justify-content: space-between;
    gap: 2rem;
    min-width: 10.5rem;
    color: var(--dark);
    background: var(--signal);
  }

  .btn-signal:hover {
    background: #e2ff71;
  }

  .text-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--paper);
    font-size: 0.9rem;
    text-decoration: none;
  }

  .text-link span {
    color: var(--signal);
  }

  .visual {
    min-width: 0;
    margin: 0;
    animation: rise 1000ms 120ms var(--ease) both;
  }

  .visual-frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 5;
    border: 1px solid rgba(245, 244, 237, 0.18);
    background: #080a08;
  }

  .visual-frame::after {
    content: '';
    position: absolute;
    inset: 0;
    box-shadow: inset 0 0 80px rgba(0, 0, 0, 0.34);
    pointer-events: none;
  }

  video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .scanline {
    position: absolute;
    inset: 0;
    opacity: 0.13;
    pointer-events: none;
    background: repeating-linear-gradient(0deg, transparent 0 3px, rgba(255, 255, 255, 0.14) 4px);
  }

  .frame-label,
  .frame-counter {
    position: absolute;
    z-index: 1;
    top: 1rem;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.08em;
  }

  .frame-label {
    left: 1rem;
    padding: 0.42rem 0.55rem;
    color: var(--paper);
    background: rgba(17, 19, 15, 0.72);
    backdrop-filter: blur(8px);
  }

  .frame-label span {
    color: var(--signal);
  }

  .frame-counter {
    right: 1rem;
    padding: 0.42rem 0.55rem;
    color: var(--dark);
    background: var(--signal);
  }

  figcaption {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.75rem;
    color: var(--paper-muted);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.08em;
  }

  .pipeline {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: clamp(3rem, 7vh, 5rem);
    border-top: 1px solid rgba(245, 244, 237, 0.16);
  }

  .pipeline-step {
    position: relative;
    padding: 1.25rem 1rem 1.5rem 0;
    border-right: 1px solid rgba(245, 244, 237, 0.16);
  }

  .pipeline-step:not(:first-child) {
    padding-left: 1rem;
  }

  .pipeline-step:last-child {
    border-right: 0;
  }

  .pipeline-step span {
    color: var(--signal);
    font-family: var(--font-mono);
    font-size: 0.58rem;
  }

  .pipeline-step strong {
    display: block;
    margin-top: 0.45rem;
    font-family: var(--font-display);
    font-size: 1rem;
    letter-spacing: -0.02em;
  }

  .pipeline-step p {
    margin: 0.1rem 0 0;
    color: var(--paper-muted);
    font-size: 0.72rem;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(24px);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (max-width: 920px) {
    .hero {
      min-height: auto;
      padding-top: 7.5rem;
    }

    .hero-grid {
      grid-template-columns: 1fr;
      gap: 3rem;
    }

    h1 {
      max-width: 14ch;
      font-size: clamp(3.1rem, 10vw, 5.4rem);
    }

    .visual {
      width: min(100%, 38rem);
      margin-left: auto;
    }

    .visual-frame {
      aspect-ratio: 16 / 11;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: 6.5rem;
    }

    h1 {
      font-size: clamp(2.65rem, 12vw, 4rem);
      line-height: 1.02;
    }

    .support {
      margin-top: 1.25rem;
    }

    .visual-frame {
      aspect-ratio: 4 / 3;
    }

    figcaption span:last-child {
      display: none;
    }

    .pipeline {
      grid-template-columns: 1fr 1fr;
    }

    .pipeline-step:nth-child(2) {
      border-right: 0;
    }

    .pipeline-step:nth-child(-n + 2) {
      border-bottom: 1px solid rgba(245, 244, 237, 0.16);
    }
  }
</style>
