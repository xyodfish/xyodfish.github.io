---
import { siteMeta, type Locale, copy } from '../content/site';

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
const t = copy[locale];
---

<section class="hero">
  <div class="media" aria-hidden="true">
    <video autoplay muted loop playsinline preload="metadata">
      <source src="/media/puppet-walk.mp4" type="video/mp4" />
    </video>
  </div>
  <div class="veil" aria-hidden="true"></div>

  <div class="site-shell copy">
    <p class="brand">{siteMeta.brand}</p>
    <p class="role">{t.hero.role}</p>
    <h1>{t.hero.lead}</h1>
    <p class="support">{t.hero.support}</p>
    <div class="actions">
      <a class="btn btn-on-dark" href={siteMeta.github} target="_blank" rel="noopener noreferrer">
        {t.hero.ctaGithub}
      </a>
      <a class="btn btn-ghost-on-dark" href="#work">{t.hero.ctaWork}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: min(88svh, 820px);
    display: grid;
    align-items: end;
    overflow: hidden;
    color: var(--hero-ink);
  }

  .media,
  .veil {
    position: absolute;
    inset: 0;
  }

  .media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.04);
    animation: drift 28s var(--ease) infinite alternate;
  }

  .veil {
    background:
      linear-gradient(105deg, rgba(8, 14, 12, 0.9) 0%, rgba(8, 14, 12, 0.55) 46%, rgba(8, 14, 12, 0.25) 100%),
      linear-gradient(0deg, rgba(8, 14, 12, 0.72) 0%, transparent 45%);
  }

  .copy {
    position: relative;
    z-index: 1;
    padding: clamp(5.5rem, 12vw, 8rem) 0 clamp(3rem, 7vw, 4.25rem);
    max-width: 38rem;
    animation: rise 900ms var(--ease) both;
  }

  .brand {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 8vw, 5.2rem);
    font-weight: 780;
    letter-spacing: -0.055em;
    line-height: 0.92;
  }

  .role {
    margin: 1.1rem 0 0;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent-bright);
  }

  h1 {
    margin: 0.85rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(1.3rem, 2.5vw, 1.75rem);
    font-weight: 560;
    letter-spacing: -0.03em;
    line-height: 1.28;
    max-width: 22ch;
  }

  .support {
    margin: 1rem 0 0;
    max-width: 32rem;
    color: var(--hero-muted);
    font-size: 1.02rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: 1.75rem;
  }

  @keyframes drift {
    from {
      transform: scale(1.04) translate3d(0, 0, 0);
    }

    to {
      transform: scale(1.1) translate3d(-1.5%, -1%, 0);
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(22px);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
