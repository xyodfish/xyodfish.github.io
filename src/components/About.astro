---
import { type Locale, copy } from '../content/site';

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
const t = copy[locale];
---

<section class="section about" id="about">
  <div class="site-shell">
    <div class="about-grid reveal">
      <header>
        <p class="kicker">{t.nav.about} / 04</p>
        <h2>{t.about.title}</h2>
        <p class="intro">{t.about.intro}</p>
      </header>

      <ol>
        {
          t.about.steps.map((step, index) => (
            <li>
              <span class="num">{String(index + 1).padStart(2, '0')}</span>
              <div>
                <h3>{step.title}</h3>
                <p>{step.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <div class="stack reveal">
      <p>{t.about.stackLabel}</p>
      <div>
        {t.about.stackItems.map((item) => (
          <span>{item}</span>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    color: var(--dark);
    background: var(--signal);
  }

  .about-grid {
    display: grid;
    grid-template-columns: minmax(18rem, 0.85fr) minmax(24rem, 1.15fr);
    gap: clamp(3rem, 9vw, 8rem);
  }

  header {
    position: sticky;
    top: 7rem;
    align-self: start;
  }

  .kicker {
    margin: 0 0 1rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
  }

  h2 {
    max-width: 8ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(3rem, 6vw, 6rem);
    font-weight: 720;
    letter-spacing: -0.065em;
    line-height: 0.9;
  }

  .intro {
    max-width: 30rem;
    margin: 1.6rem 0 0;
    font-size: 1.05rem;
    line-height: 1.6;
  }

  ol {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid rgba(17, 19, 15, 0.32);
  }

  li {
    display: grid;
    grid-template-columns: 3.5rem 1fr;
    gap: 1.2rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid rgba(17, 19, 15, 0.32);
  }

  .num {
    padding-top: 0.18rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
  }

  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2vw, 1.65rem);
    letter-spacing: -0.035em;
  }

  li p {
    margin: 0.45rem 0 0;
    color: rgba(17, 19, 15, 0.72);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  .stack {
    display: grid;
    grid-template-columns: 0.75fr 2.25fr;
    gap: 2rem;
    margin-top: clamp(3.5rem, 8vw, 6rem);
    padding-top: 1.5rem;
    border-top: 1px solid rgba(17, 19, 15, 0.32);
  }

  .stack p {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .stack div {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
  }

  .stack span {
    padding: 0.38rem 0.68rem;
    border: 1px solid rgba(17, 19, 15, 0.38);
    font-family: var(--font-mono);
    font-size: 0.66rem;
  }

  @media (max-width: 760px) {
    .about-grid,
    .stack {
      grid-template-columns: 1fr;
    }

    header {
      position: static;
    }

    h2 {
      max-width: none;
    }
  }
</style>
