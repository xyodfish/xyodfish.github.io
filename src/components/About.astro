---
import SectionHead from './SectionHead.astro';
import { type Locale, copy } from '../content/site';

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
const t = copy[locale];
---

<section class="section site-shell" id="about">
  <div class="reveal">
    <SectionHead kicker={t.nav.about} title={t.about.title} intro={t.about.intro} />
  </div>

  <div class="steps reveal">
    {
      t.about.steps.map((step, i) => (
        <div class="step">
          <span class="num">{String(i + 1).padStart(2, '0')}</span>
          <h3>{step.title}</h3>
          <p>{step.body}</p>
        </div>
      ))
    }
  </div>

  <div class="stack reveal">
    <p class="stack-label">{t.about.stackLabel}</p>
    <div class="tag-row">
      {t.about.stackItems.map((item) => (
        <span class="tag">{item}</span>
      ))}
    </div>
  </div>
</section>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    margin-bottom: 2.25rem;
    border-top: 1px solid var(--line);
  }

  .step {
    padding: 1.25rem 1.1rem 1.35rem 0;
    border-right: 1px solid var(--line);
  }

  .step:last-child {
    border-right: 0;
    padding-right: 0;
  }

  .step:first-child {
    padding-left: 0;
  }

  .num {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--accent);
  }

  h3 {
    margin: 0.65rem 0 0;
    font-family: var(--font-display);
    font-size: 1.08rem;
    letter-spacing: -0.025em;
  }

  p {
    margin: 0.4rem 0 0;
    font-size: 0.9rem;
    color: var(--muted);
    line-height: 1.5;
  }

  .stack-label {
    margin: 0 0 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  @media (max-width: 820px) {
    .steps {
      grid-template-columns: 1fr 1fr;
    }

    .step {
      border-right: 0;
      border-bottom: 1px solid var(--line);
      padding: 1.15rem 0;
    }

    .step:nth-child(odd) {
      padding-right: 0.85rem;
    }

    .step:nth-child(even) {
      padding-left: 0.85rem;
      border-left: 1px solid var(--line);
    }
  }

  @media (max-width: 480px) {
    .steps {
      grid-template-columns: 1fr;
    }

    .step:nth-child(odd),
    .step:nth-child(even) {
      padding-inline: 0;
      border-left: 0;
    }
  }
</style>
