---
import type { Locale } from '../content/site';

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
const content = {
  zh: {
    kicker: '系统图谱 / 02',
    title: '把“怎么工作”画出来。',
    intro: '这些不是抽象的软件分层，而是已经存在于本地项目中的真实数据流。每张图只保留读者理解系统所需的层次。',
    common: {
      input: '输入',
      core: '核心',
      output: '输出',
      evidence: '实现证据',
    },
    bridge: {
      eyebrow: '动作重定向统一入口',
      title: 'MotionBridge',
      summary: '把人体数据适配、机器人间轨迹迁移和结果复核收进一个可查询能力的 CLI / WebUI，不把外部算法仓库复制进来。',
      inputs: ['SMPL-X', 'LAFAN1 / SOMA BVH', '单目视频', 'MotionDecode G1'],
      hub: '输入识别 · 能力选择 · 任务队列',
      online: ['在线', 'GMR / UMR / SOMA'],
      batch: ['离线', 'Batch TO / SOMA'],
      robots: ['G1', 'H2'],
      formats: ['NPZ', 'CSV', 'PKL', 'JSON'],
      transfer: {
        label: '跨机器人轨迹迁移',
        input: 'G1 关节轨迹',
        method: '表面对应 + 因果 QP',
        output: 'H2 关节轨迹',
        detail: '借鉴 UMR Online QP；保留水平根轨迹，并用真实 MuJoCo 模型同屏复核。',
      },
      facts: ['4 类输入', '2 台机器人', '在线 / 离线', 'G1 → H2 轨迹迁移'],
    },
    gmr: {
      eyebrow: '重定向优化',
      title: 'GMR：从逐帧求解到时序优化',
      summary: '保留 GMR 的人体缩放与目标构造，再根据在线延迟或离线质量要求选择不同的多帧优化方法。',
      baseline: {
        title: '逐帧 IK',
        note: '速度基线',
        metric: '1.7 ms / 帧',
      },
      online: {
        title: 'C++ Online QP',
        note: '短窗口 · 在线',
        metric: '7.7 ms / 帧',
        result: '平均滑脚 −55%',
      },
      batch: {
        title: 'C++ Batch TO',
        note: '滑动窗口 · 离线',
        metric: '3.5 ms / 帧',
        result: '平均滑脚 −33%',
      },
      margin: {
        title: '3° 关节限位余量',
        before: '45 帧贴近限位',
        after: '0 帧贴近限位',
        detail: '平均关节漂移约 0.05°，运行开销可忽略。',
      },
      scope: '评测范围：Unitree G1，walking / gait_track_12 / tennis，各 120 帧；变化量相对逐帧 IK。',
    },
  },
  en: {
    kicker: 'System maps / 02',
    title: 'Show how the systems work.',
    intro: 'These are not abstract software layers. Each map reflects a real data path in the local projects, reduced to the detail a reader needs.',
    common: {
      input: 'Input',
      core: 'Core',
      output: 'Output',
      evidence: 'Implementation evidence',
    },
    bridge: {
      eyebrow: 'Unified retargeting entry',
      title: 'MotionBridge',
      summary: 'One capability-aware CLI / WebUI for human-data adapters, robot-to-robot trajectory transfer, and result review—without copying external algorithm repositories into the tool.',
      inputs: ['SMPL-X', 'LAFAN1 / SOMA BVH', 'Monocular video', 'MotionDecode G1'],
      hub: 'Input inspection · capability selection · job queue',
      online: ['Online', 'GMR / UMR / SOMA'],
      batch: ['Offline', 'Batch TO / SOMA'],
      robots: ['G1', 'H2'],
      formats: ['NPZ', 'CSV', 'PKL', 'JSON'],
      transfer: {
        label: 'Cross-robot trajectory transfer',
        input: 'G1 joint trajectory',
        method: 'Surface mapping + causal QP',
        output: 'H2 joint trajectory',
        detail: 'Inspired by UMR Online QP; preserves horizontal root travel and supports side-by-side review on the actual MuJoCo models.',
      },
      facts: ['4 input families', '2 robots', 'Online / offline', 'G1 → H2 trajectory transfer'],
    },
    gmr: {
      eyebrow: 'Retargeting optimization',
      title: 'GMR: from frame-wise IK to temporal optimization',
      summary: 'Keep GMR’s human scaling and target construction, then choose a multi-frame optimizer for online latency or offline quality.',
      baseline: {
        title: 'Frame-wise IK',
        note: 'Speed baseline',
        metric: '1.7 ms / frame',
      },
      online: {
        title: 'C++ Online QP',
        note: 'Short horizon · online',
        metric: '7.7 ms / frame',
        result: 'Mean foot slip −55%',
      },
      batch: {
        title: 'C++ Batch TO',
        note: 'Sliding windows · offline',
        metric: '3.5 ms / frame',
        result: 'Mean foot slip −33%',
      },
      margin: {
        title: '3° joint-limit margin',
        before: '45 near-limit frames',
        after: '0 near-limit frames',
        detail: 'About 0.05° mean joint drift with negligible runtime cost.',
      },
      scope: 'Scope: Unitree G1; walking, gait_track_12, and tennis; 120 frames each. Deltas are relative to frame-wise IK.',
    },
  },
} as const;

const c = content[locale];
---

<section class="atlas" id="atlas">
  <div class="site-shell">
    <header class="atlas-head">
      <div>
        <p class="section-kicker">{c.kicker}</p>
        <h2>{c.title}</h2>
      </div>
      <p>{c.intro}</p>
    </header>

    <div class="atlas-grid">
      <article class="map-card map-card-wide bridge-card">
        <header class="card-head">
          <div>
            <p>{c.bridge.eyebrow}</p>
            <h3>{c.bridge.title}</h3>
          </div>
          <span>01</span>
        </header>
        <p class="card-summary">{c.bridge.summary}</p>
        <figure class="bridge-map" aria-label={`${c.bridge.title} architecture`}>
          <div class="map-column">
            <small>{c.common.input}</small>
            {c.bridge.inputs.map((item) => <span>{item}</span>)}
          </div>
          <div class="hub-node">
            <small>MOTIONBRIDGE</small>
            <strong>{c.bridge.hub}</strong>
          </div>
          <div class="method-column">
            <div>
              <small>{c.bridge.online[0]}</small>
              <strong>{c.bridge.online[1]}</strong>
            </div>
            <div>
              <small>{c.bridge.batch[0]}</small>
              <strong>{c.bridge.batch[1]}</strong>
            </div>
          </div>
          <div class="map-column output-column">
            <small>{c.common.output}</small>
            <span>{c.bridge.robots.join(' · ')}</span>
            <span>{c.bridge.formats.join(' · ')}</span>
          </div>
          <div class="transfer-lane">
            <small>{c.bridge.transfer.label}</small>
            <div class="transfer-flow">
              <strong>{c.bridge.transfer.input}</strong>
              <i aria-hidden="true">→</i>
              <strong>{c.bridge.transfer.method}</strong>
              <i aria-hidden="true">→</i>
              <strong>{c.bridge.transfer.output}</strong>
            </div>
            <p>{c.bridge.transfer.detail}</p>
          </div>
        </figure>
        <ul class="fact-row fact-row-four">
          {c.bridge.facts.map((fact) => <li>{fact}</li>)}
        </ul>
      </article>

      <article class="map-card map-card-wide gmr-card">
        <header class="card-head">
          <div>
            <p>{c.gmr.eyebrow}</p>
            <h3>{c.gmr.title}</h3>
          </div>
          <span>02</span>
        </header>
        <p class="card-summary">{c.gmr.summary}</p>
        <figure class="gmr-map" aria-label={`${c.gmr.title} comparison`}>
          <div class="strategy baseline">
            <small>{c.gmr.baseline.note}</small>
            <strong>{c.gmr.baseline.title}</strong>
            <b>{c.gmr.baseline.metric}</b>
          </div>
          <div class="strategy-arrow" aria-hidden="true">→</div>
          <div class="strategy optimized">
            <small>{c.gmr.online.note}</small>
            <strong>{c.gmr.online.title}</strong>
            <b>{c.gmr.online.metric}</b>
            <em>{c.gmr.online.result}</em>
          </div>
          <div class="strategy optimized">
            <small>{c.gmr.batch.note}</small>
            <strong>{c.gmr.batch.title}</strong>
            <b>{c.gmr.batch.metric}</b>
            <em>{c.gmr.batch.result}</em>
          </div>
          <div class="margin-card">
            <small>{c.gmr.margin.title}</small>
            <div>
              <span>{c.gmr.margin.before}</span>
              <i aria-hidden="true">→</i>
              <strong>{c.gmr.margin.after}</strong>
            </div>
            <p>{c.gmr.margin.detail}</p>
          </div>
          <figcaption>{c.gmr.scope}</figcaption>
        </figure>
      </article>
    </div>
  </div>
</section>

<style>
  .atlas {
    padding: clamp(5rem, 10vw, 9rem) 0;
    color: var(--paper);
    background:
      radial-gradient(circle at 8% 18%, rgba(212, 242, 92, 0.08), transparent 26rem),
      linear-gradient(rgba(245, 244, 237, 0.032) 1px, transparent 1px),
      linear-gradient(90deg, rgba(245, 244, 237, 0.032) 1px, transparent 1px),
      var(--dark);
    background-size: auto, 52px 52px, 52px 52px, auto;
  }

  .atlas-head {
    display: grid;
    grid-template-columns: minmax(18rem, 0.8fr) minmax(22rem, 1.2fr);
    align-items: end;
    gap: clamp(2rem, 7vw, 7rem);
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid rgba(245, 244, 237, 0.2);
  }

  .atlas-head h2 {
    max-width: 11ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 5vw, 5.2rem);
    font-weight: 720;
    letter-spacing: -0.06em;
    line-height: 0.94;
  }

  .atlas-head > p {
    max-width: 40rem;
    margin: 0;
    color: var(--paper-muted);
    font-size: 1.06rem;
  }

  .atlas :global(.section-kicker) {
    color: var(--signal);
  }

  .atlas-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin-top: 1px;
    background: rgba(245, 244, 237, 0.18);
    border: 1px solid rgba(245, 244, 237, 0.18);
  }

  .map-card {
    min-width: 0;
    padding: clamp(1.5rem, 3.5vw, 3rem);
    background: rgba(10, 12, 9, 0.95);
  }

  .map-card-wide {
    grid-column: 1 / -1;
  }

  .card-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 2rem;
  }

  .card-head p {
    margin: 0;
    color: var(--signal);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .card-head h3 {
    margin: 0.6rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(2rem, 3.5vw, 3.7rem);
    letter-spacing: -0.055em;
    line-height: 0.95;
  }

  .card-head > span {
    color: rgba(245, 244, 237, 0.28);
    font-family: var(--font-mono);
    font-size: 0.68rem;
  }

  .card-summary {
    max-width: 46rem;
    margin: 1.2rem 0 0;
    color: var(--paper-muted);
  }

  figure {
    margin: 2rem 0 0;
  }

  figcaption {
    color: rgba(245, 244, 237, 0.5);
    font-family: var(--font-mono);
    font-size: 0.58rem;
    line-height: 1.6;
  }

  .bridge-map,
  .gmr-map {
    padding: clamp(1rem, 2vw, 1.5rem);
    border: 1px solid rgba(245, 244, 237, 0.16);
    background:
      linear-gradient(rgba(212, 242, 92, 0.045) 1px, transparent 1px),
      linear-gradient(90deg, rgba(212, 242, 92, 0.045) 1px, transparent 1px),
      #080a07;
    background-size: 24px 24px;
  }

  .gmr-map figcaption {
    grid-column: 1 / -1;
    margin-top: 0.5rem;
    padding-top: 0.8rem;
    border-top: 1px solid rgba(245, 244, 237, 0.12);
  }

  .map-column > small,
  .method-column small,
  .hub-node small,
  .transfer-lane > small,
  .strategy small,
  .margin-card > small {
    display: block;
    color: var(--signal);
    font-family: var(--font-mono);
    font-size: 0.52rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .fact-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin: 1px 0 0;
    padding: 0;
    background: rgba(245, 244, 237, 0.16);
    list-style: none;
  }

  .fact-row-four {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .fact-row li {
    padding: 0.75rem;
    color: rgba(245, 244, 237, 0.68);
    background: #0b0d0a;
    font-family: var(--font-mono);
    font-size: 0.57rem;
  }

  .fact-row li::before {
    content: '↳';
    margin-right: 0.45rem;
    color: var(--signal);
  }

  .bridge-map {
    display: grid;
    grid-template-columns: 1.1fr 1.25fr 1fr 1fr;
    align-items: stretch;
    gap: clamp(0.7rem, 2vw, 1.5rem);
  }

  .map-column,
  .method-column {
    display: grid;
    align-content: start;
    gap: 0.45rem;
  }

  .map-column span,
  .method-column > div,
  .hub-node {
    padding: 0.7rem;
    border: 1px solid rgba(245, 244, 237, 0.18);
    color: rgba(245, 244, 237, 0.78);
    background: rgba(17, 19, 15, 0.9);
    font-family: var(--font-mono);
    font-size: 0.62rem;
  }

  .hub-node {
    position: relative;
    display: grid;
    place-content: center;
    border-color: rgba(212, 242, 92, 0.48);
    background: rgba(212, 242, 92, 0.06);
    text-align: center;
  }

  .hub-node::before,
  .hub-node::after {
    content: '→';
    position: absolute;
    top: 50%;
    color: var(--signal);
    transform: translateY(-50%);
  }

  .hub-node::before {
    left: -1.1rem;
  }

  .hub-node::after {
    right: -1.1rem;
  }

  .hub-node strong {
    display: block;
    max-width: 15rem;
    margin-top: 0.75rem;
    font-family: var(--font-display);
    font-size: 1rem;
    line-height: 1.25;
  }

  .method-column > div {
    display: grid;
    align-content: center;
    min-height: 4.5rem;
  }

  .method-column strong {
    margin-top: 0.45rem;
    font-family: var(--font-display);
    font-size: 0.85rem;
  }

  .output-column span {
    min-height: 4.1rem;
  }

  .transfer-lane {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: minmax(8rem, 0.5fr) minmax(24rem, 1.5fr) minmax(14rem, 0.8fr);
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    border: 1px solid rgba(212, 242, 92, 0.42);
    background: rgba(212, 242, 92, 0.055);
  }

  .transfer-flow {
    display: grid;
    grid-template-columns: 1fr auto 1.25fr auto 1fr;
    align-items: center;
    gap: 0.7rem;
  }

  .transfer-flow strong {
    padding: 0.65rem;
    border: 1px solid rgba(245, 244, 237, 0.16);
    color: var(--paper);
    background: rgba(8, 10, 7, 0.72);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 500;
    text-align: center;
  }

  .transfer-flow i {
    color: var(--signal);
    font-style: normal;
  }

  .transfer-lane p {
    margin: 0;
    color: var(--paper-muted);
    font-size: 0.7rem;
    line-height: 1.5;
  }

  .gmr-map {
    display: grid;
    grid-template-columns: 0.8fr auto 1fr 1fr;
    gap: clamp(0.7rem, 2vw, 1.5rem);
    align-items: stretch;
  }

  .strategy {
    display: grid;
    align-content: center;
    min-height: 9rem;
    padding: 1rem;
    border: 1px solid rgba(245, 244, 237, 0.2);
    background: rgba(17, 19, 15, 0.92);
  }

  .strategy.optimized {
    border-color: rgba(212, 242, 92, 0.42);
    background: rgba(212, 242, 92, 0.055);
  }

  .strategy strong {
    margin-top: 0.65rem;
    font-family: var(--font-display);
    font-size: clamp(1rem, 2vw, 1.4rem);
    line-height: 1.05;
  }

  .strategy b {
    margin-top: 1.1rem;
    color: var(--paper);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .strategy em {
    margin-top: 0.4rem;
    color: var(--signal);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-style: normal;
  }

  .strategy-arrow {
    display: grid;
    place-items: center;
    color: var(--signal);
  }

  .margin-card {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: 0.7fr 1.4fr 1fr;
    align-items: center;
    gap: 1rem;
    padding: 1rem;
    border: 1px solid rgba(245, 244, 237, 0.16);
    background: rgba(245, 244, 237, 0.035);
  }

  .margin-card > div {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.65rem;
  }

  .margin-card i {
    color: var(--signal);
    font-style: normal;
  }

  .margin-card strong {
    color: var(--signal);
  }

  .margin-card p {
    margin: 0;
    color: var(--paper-muted);
    font-size: 0.72rem;
  }

  @media (max-width: 980px) {
    .atlas-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .map-card-wide {
      grid-column: auto;
    }

    .bridge-map {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .hub-node::before,
    .hub-node::after {
      content: none;
    }
  }

  @media (max-width: 720px) {
    .atlas-head {
      grid-template-columns: 1fr;
      align-items: start;
    }

    .atlas-head h2 {
      max-width: 10ch;
    }

    .fact-row,
    .fact-row-four {
      grid-template-columns: 1fr;
    }

    .bridge-map,
    .gmr-map {
      grid-template-columns: 1fr;
    }

    .strategy-arrow {
      min-height: 1rem;
      transform: rotate(90deg);
    }

    .margin-card {
      grid-column: auto;
      grid-template-columns: 1fr;
    }

    .transfer-lane {
      grid-column: auto;
      grid-template-columns: 1fr;
    }

    .transfer-flow {
      grid-template-columns: 1fr;
    }

    .transfer-flow i {
      text-align: center;
      transform: rotate(90deg);
    }

    .margin-card > div {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.35rem;
    }
  }
</style>
