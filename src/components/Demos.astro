---
import { type Locale, copy } from '../content/site';

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
const t = copy[locale];
---

<section class="section demos" id="demos">
  <div class="site-shell">
    <header class="demos-head reveal">
      <div>
        <p class="section-kicker">{t.nav.demos} / 05</p>
        <h2>{locale === 'zh' ? '让运动本身成为证据。' : 'Let the motion be evidence.'}</h2>
      </div>
      <p>
        {locale === 'zh'
          ? '精选运行片段，不用重复视频淹没系统结构。每段都标明它实际展示的链路。'
          : 'A small set of running clips. Each caption states the pipeline it actually demonstrates.'}
      </p>
    </header>

    <div class="clip-grid reveal">
      {
        t.clips.map((clip, index) => (
          <figure class={index === 0 || index === 3 ? 'wide' : ''}>
            <div class="frame">
              <video muted loop playsinline preload="none" data-lazy-video aria-label={clip.caption}>
                <source src={clip.src} type="video/mp4" />
              </video>
              <span class="clip-no">{String(index + 1).padStart(2, '0')}</span>
            </div>
            <figcaption>
              <strong>{clip.caption}</strong>
              <span>{clip.context}</span>
            </figcaption>
          </figure>
        ))
      }
    </div>
  </div>
</section>

<style>
  .demos {
    color: var(--paper);
    background: var(--dark);
  }

  .demos :global(.section-kicker) {
    color: var(--signal);
  }

  .demos-head {
    display: grid;
    grid-template-columns: minmax(20rem, 1.3fr) minmax(16rem, 0.7fr);
    align-items: end;
    gap: 3rem;
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }

  .demos-head h2 {
    max-width: 11ch;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(2.8rem, 6vw, 6rem);
    font-weight: 720;
    letter-spacing: -0.065em;
    line-height: 0.92;
  }

  .demos-head > p {
    max-width: 27rem;
    margin: 0;
    color: var(--paper-muted);
  }

  .clip-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 1.5rem) 0.8rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgba(245, 244, 237, 0.16);
  }

  figure {
    min-width: 0;
    margin: 0;
  }

  figure.wide {
    grid-column: span 2;
  }

  .frame {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: #070907;
  }

  figure.wide .frame {
    aspect-ratio: 16 / 7.9;
  }

  video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.82);
    transition:
      filter 350ms var(--ease),
      transform 650ms var(--ease);
  }

  figure:hover video {
    filter: saturate(1);
    transform: scale(1.025);
  }

  .clip-no {
    position: absolute;
    top: 0.65rem;
    right: 0.65rem;
    padding: 0.3rem 0.4rem;
    color: var(--dark);
    background: var(--signal);
    font-family: var(--font-mono);
    font-size: 0.55rem;
  }

  figcaption {
    display: grid;
    gap: 0.15rem;
    margin-top: 0.65rem;
  }

  figcaption strong {
    font-family: var(--font-display);
    font-size: 0.86rem;
  }

  figcaption span {
    color: var(--paper-muted);
    font-family: var(--font-mono);
    font-size: 0.58rem;
  }

  @media (max-width: 920px) {
    .clip-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 680px) {
    .demos-head {
      grid-template-columns: 1fr;
      gap: 1.5rem;
    }

    .clip-grid {
      display: flex;
      gap: 0.75rem;
      overflow-x: auto;
      margin-inline: -0.75rem;
      padding: 1.25rem 0.75rem 1rem;
      scroll-snap-type: x mandatory;
      scrollbar-width: thin;
    }

    figure,
    figure.wide {
      flex: 0 0 82%;
      scroll-snap-align: start;
    }

    figure.wide .frame {
      aspect-ratio: 4 / 3;
    }
  }
</style>
