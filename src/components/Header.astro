---
import { siteMeta, type Locale, copy } from '../content/site';

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
const t = copy[locale];
---

<header class="header" data-header>
  <div class="site-shell header-inner">
    <a class="brand" href={locale === 'zh' ? '/' : '/en/'}>{siteMeta.brand}</a>
    <nav aria-label={locale === 'zh' ? '主导航' : 'Primary'}>
      <a href="#work">{t.nav.work}</a>
      <a href="#demos">{t.nav.demos}</a>
      <a href="#contact">{t.nav.contact}</a>
      <a class="lang" href={t.nav.langHref}>{t.nav.langOther}</a>
    </nav>
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 40;
    transition:
      background 280ms var(--ease),
      border-color 280ms var(--ease),
      color 280ms var(--ease);
    color: var(--hero-ink);
    border-bottom: 1px solid transparent;
  }

  .header.is-solid {
    color: var(--ink);
    background: rgba(238, 242, 239, 0.9);
    border-bottom-color: var(--line);
    backdrop-filter: blur(14px);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3.6rem;
    gap: 1rem;
  }

  .brand {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 720;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    gap: 0.75rem 1.05rem;
    font-size: 0.88rem;
  }

  nav a {
    text-decoration: none;
    color: inherit;
    opacity: 0.78;
  }

  nav a:hover {
    opacity: 1;
  }

  .lang {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    padding: 0.22rem 0.5rem;
    border: 1px solid currentColor;
    opacity: 0.85;
  }
</style>

<script>
  const header = document.querySelector('[data-header]');

  if (header) {
    const sync = () => {
      header.classList.toggle('is-solid', window.scrollY > 48);
    };

    sync();
    window.addEventListener('scroll', sync, { passive: true });
  }
</script>
