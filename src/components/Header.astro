---
import { siteMeta, type Locale, copy } from '../content/site';

type Props = {
  locale: Locale;
  languageHref?: string;
};

const { locale, languageHref } = Astro.props;
const t = copy[locale];
const homeHref = locale === 'zh' ? '/' : '/en/';
---

<header class="header" data-header>
  <div class="site-shell header-inner">
    <a class="brand" href={homeHref} aria-label={`${siteMeta.brand} · Home`}>
      <span class="brand-dot" aria-hidden="true"></span>
      <span>{siteMeta.brand}</span>
    </a>
    <nav aria-label={locale === 'zh' ? '主导航' : 'Primary'}>
      <a href={`${homeHref}#work`}>{t.nav.work}</a>
      <a href={`${homeHref}#atlas`}>{t.nav.atlas}</a>
      <a href={`${homeHref}#evidence`}>{t.nav.evidence}</a>
      <a href={`${homeHref}#about`}>{t.nav.about}</a>
      <a href={`${homeHref}#demos`}>{t.nav.demos}</a>
      <a href={`${homeHref}#contact`}>{t.nav.contact}</a>
      <a class="lang" href={languageHref ?? t.nav.langHref}>{t.nav.langOther}</a>
    </nav>
  </div>
</header>

<style>
  .header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 40;
    color: var(--paper);
    border-bottom: 1px solid rgba(245, 244, 237, 0.13);
    background: rgba(17, 19, 15, 0.68);
    backdrop-filter: blur(18px);
    transition:
      background 280ms var(--ease),
      border-color 280ms var(--ease),
      color 280ms var(--ease);
  }

  .header.is-solid {
    color: var(--ink);
    background: rgba(245, 244, 237, 0.88);
    border-bottom-color: var(--line-strong);
  }

  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 4.25rem;
    gap: 1rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-display);
    font-size: 1rem;
    font-weight: 750;
    letter-spacing: -0.03em;
    text-decoration: none;
  }

  .brand-dot {
    width: 0.58rem;
    height: 0.58rem;
    border-radius: 50%;
    background: var(--signal);
    box-shadow: 0 0 0 4px rgba(212, 242, 92, 0.12);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    align-items: center;
    gap: 0.75rem 1.2rem;
    font-size: 0.82rem;
  }

  nav a {
    color: inherit;
    opacity: 0.72;
    text-decoration: none;
  }

  nav a:hover {
    opacity: 1;
  }

  .lang {
    padding: 0.3rem 0.55rem;
    border: 1px solid currentColor;
    font-family: var(--font-mono);
    font-size: 0.64rem;
    opacity: 0.85;
  }

  @media (max-width: 640px) {
    .header-inner {
      min-height: 3.75rem;
    }

    nav {
      gap: 0.8rem;
    }

    nav a:nth-child(2),
    nav a:nth-child(4),
    nav a:nth-child(5) {
      display: none;
    }
  }
</style>

<script>
  const header = document.querySelector('[data-header]');

  if (header) {
    const sync = () => {
      header.classList.toggle('is-solid', window.scrollY > 80);
    };

    sync();
    window.addEventListener('scroll', sync, { passive: true });
  }
</script>
