---
import { siteMeta, type Locale, copy } from '../content/site';

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
const t = copy[locale];
---

<section class="section" id="contact">
  <div class="site-shell reveal">
    <div class="band">
      <div>
        <p class="section-kicker">{t.nav.contact}</p>
        <h2 class="section-title">{t.contact.title}</h2>
        <p class="section-intro">{t.contact.body}</p>
        <div class="tag-row stack">
          {t.about.stackItems.map((item) => (
            <span class="tag">{item}</span>
          ))}
        </div>
      </div>
      <a class="btn btn-primary" href={siteMeta.github} target="_blank" rel="noopener noreferrer">
        {t.contact.github}
      </a>
    </div>
  </div>
</section>

<style>
  .band {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    padding: clamp(1.75rem, 4vw, 2.4rem) 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .section-title {
    max-width: none;
  }

  .stack {
    margin-top: 1rem;
  }

  @media (max-width: 640px) {
    .band {
      flex-direction: column;
      align-items: start;
    }
  }
</style>
