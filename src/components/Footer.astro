---
import { siteMeta, type Locale, copy } from '../content/site';

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
const t = copy[locale];
const year = new Date().getFullYear();
---

<footer>
  <div class="site-shell inner">
    <p><strong>{siteMeta.brand}</strong> · {t.footer.note}</p>
    <p class="year">© {year}</p>
  </div>
</footer>

<style>
  footer {
    padding: 1.75rem 0 2.6rem;
  }

  .inner {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--muted);
    font-size: 0.92rem;
  }

  strong {
    color: var(--ink);
    font-family: var(--font-display);
    letter-spacing: -0.03em;
  }

  .year {
    font-family: var(--font-mono);
    font-size: 0.76rem;
  }

  p {
    margin: 0;
  }
</style>
