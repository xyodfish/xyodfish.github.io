---
import SectionHead from './SectionHead.astro';
import { type Locale, copy } from '../content/site';

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
const t = copy[locale];
---

<section class="section site-shell" id="work">
  <div class="reveal">
    <SectionHead kicker={t.nav.work} title={t.work.title} intro={t.work.intro} />
  </div>

  <div class="grid featured">
    {
      t.featured.map((project) => (
        <article class="card reveal">
          <div class="media">
            {project.media ? (
              <video muted loop playsinline preload="metadata" data-lazy-video>
                <source src={project.media.src} type="video/mp4" />
              </video>
            ) : (
              <div class="placeholder">{project.name}</div>
            )}
          </div>
          <div class="body">
            <p class="role">{project.role}</p>
            <h3>{project.name}</h3>
            <p class="summary">{project.summary}</p>
            <div class="tag-row">
              {project.tags.map((tag) => (
                <span class="tag">{tag}</span>
              ))}
            </div>
          </div>
        </article>
      ))
    }
  </div>

  <div class="systems reveal">
    <div class="systems-head">
      <h3>{t.systems.title}</h3>
      <p>{t.systems.intro}</p>
    </div>
    <div class="grid systems-grid">
      {
        t.systems.items.map((project) => (
          <article class="card compact">
            <div class="media">
              {project.media ? (
                <video muted loop playsinline preload="metadata" data-lazy-video>
                  <source src={project.media.src} type="video/mp4" />
                </video>
              ) : (
                <div class="placeholder muted">{project.name}</div>
              )}
            </div>
            <div class="body">
              <p class="role">{project.role}</p>
              <h3>{project.name}</h3>
              <p class="summary">{project.summary}</p>
              <div class="tag-row">
                {project.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            </div>
          </article>
        ))
      }
    </div>
  </div>

  <div class="more reveal">
    <p class="more-label">{t.more.title}</p>
    <ul>
      {
        t.more.items.map((item) => (
          <li>
            <strong>{item.name}</strong>
            <span>{item.summary}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .grid {
    display: grid;
    gap: 1.15rem;
  }

  .featured {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .card {
    display: flex;
    flex-direction: column;
    background: rgba(255, 255, 255, 0.45);
    border: 1px solid var(--line);
    overflow: hidden;
    transition:
      transform 280ms var(--ease),
      border-color 280ms var(--ease);
  }

  .card:hover {
    transform: translateY(-3px);
    border-color: var(--line-strong);
  }

  .media {
    aspect-ratio: 16 / 10;
    background: #0f1412;
  }

  .compact .media {
    aspect-ratio: 16 / 11;
  }

  video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .placeholder {
    height: 100%;
    display: grid;
    place-items: center;
    color: #e8efeb;
    font-family: var(--font-display);
    font-size: 1.35rem;
    letter-spacing: -0.03em;
    text-align: center;
    padding: 1rem;
    background:
      radial-gradient(circle at 70% 20%, rgba(12, 107, 90, 0.35), transparent 50%),
      linear-gradient(160deg, #1a2420, #0f1412);
  }

  .placeholder.muted {
    font-size: 1.05rem;
  }

  .body {
    padding: 1rem 1.1rem 1.15rem;
    display: grid;
    gap: 0.4rem;
  }

  .role {
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: 1.28rem;
    letter-spacing: -0.03em;
  }

  .summary {
    margin: 0;
    color: var(--ink-soft);
    font-size: 0.94rem;
    line-height: 1.5;
  }

  .systems {
    margin-top: clamp(2.75rem, 6vw, 3.75rem);
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .systems-head {
    margin-bottom: 1.15rem;
    max-width: 38rem;
  }

  .systems-head h3 {
    margin: 0;
    font-size: 1.35rem;
  }

  .systems-head p {
    margin: 0.4rem 0 0;
    color: var(--ink-soft);
    font-size: 0.95rem;
  }

  .systems-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .more {
    margin-top: 2.25rem;
  }

  .more-label {
    margin: 0 0 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .more ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.85rem 1.25rem;
  }

  .more li {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .more strong {
    font-family: var(--font-display);
    font-weight: 650;
    letter-spacing: -0.02em;
  }

  .more span {
    color: var(--muted);
    font-size: 0.88rem;
  }

  @media (max-width: 820px) {
    .featured,
    .systems-grid,
    .more ul {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  const videos = document.querySelectorAll('#work [data-lazy-video]');

  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const video = entry.target as HTMLVideoElement;

          if (entry.isIntersecting) {
            video.play().catch(() => {});
          } else {
            video.pause();
          }
        });
      },
      { threshold: 0.3 },
    );

    videos.forEach((video) => observer.observe(video));
  }
</script>
