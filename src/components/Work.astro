---
import { type Locale, copy } from '../content/site';

type Props = {
  locale: Locale;
};

const { locale } = Astro.props;
const t = copy[locale];
const caseHref = (href: string) => (locale === 'zh' ? href : `/en${href}`);
---

<section class="section work" id="work">
  <div class="site-shell">
    <header class="work-head reveal">
      <div>
        <p class="section-kicker">{t.nav.work} / 01</p>
        <h2 class="section-title">{t.work.title}</h2>
      </div>
      <p>{t.work.intro}</p>
      <span class="count">{String(t.featured.length).padStart(2, '0')}<br />SELECTED</span>
    </header>

    <div class="cases">
      {
        t.featured.map((project, index) => (
          <article class="case reveal">
            <a class="case-media" href={caseHref(project.href)} aria-label={`${t.work.detailCta}: ${project.name}`}>
              {project.media ? (
                <video muted loop playsinline preload="none" data-lazy-video aria-label={project.media.alt}>
                  <source src={project.media.src} type="video/mp4" />
                </video>
              ) : (
                <div class="architecture" aria-label="Control system architecture">
                  <span>{locale === 'zh' ? '输入' : 'Input'}</span>
                  <i aria-hidden="true">→</i>
                  <span>{locale === 'zh' ? '模型' : 'Model'}</span>
                  <i aria-hidden="true">→</i>
                  <span>{locale === 'zh' ? '运行时' : 'Runtime'}</span>
                  <i aria-hidden="true">→</i>
                  <span>{locale === 'zh' ? '输出' : 'Output'}</span>
                </div>
              )}
              <span class="case-no">{String(index + 1).padStart(2, '0')}</span>
            </a>
            <div class="case-body">
              <p class="role">{project.role}</p>
              <h3><a href={caseHref(project.href)}>{project.name}</a></h3>
              <p class="summary">{project.summary}</p>
              <ul class="proofs">
                {project.proofs.map((proof) => <li>{proof}</li>)}
              </ul>
              <div class="case-foot">
                <div class="tag-row">
                  {project.tags.map((tag) => <span class="tag">{tag}</span>)}
                </div>
                <a class="case-link" href={caseHref(project.href)}>{t.work.detailCta}<span aria-hidden="true">↗</span></a>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <section class="systems reveal" aria-labelledby="systems-title">
      <header class="systems-head">
        <div>
          <p class="section-kicker">{locale === 'zh' ? '工具与基础设施' : 'Tools & infrastructure'}</p>
          <h3 id="systems-title">{t.systems.title}</h3>
        </div>
        <p>{t.systems.intro}</p>
      </header>
      <div class="systems-grid">
        {
          t.systems.items.map((project, index) => (
            <article class="system-card">
              <div class="system-media">
                {project.media ? (
                  <video muted loop playsinline preload="none" data-lazy-video aria-label={project.media.alt}>
                    <source src={project.media.src} type="video/mp4" />
                  </video>
                ) : (
                  <div class="tool-placeholder"><span>{project.name}</span><small>INPUT → MODEL → OUTPUT</small></div>
                )}
                <span>0{index + 1}</span>
              </div>
              <div class="system-body">
                <p class="role">{project.role}</p>
                <h4>{project.name}</h4>
                <p>{project.summary}</p>
                <div class="tag-row">
                  {project.tags.map((tag) => <span class="tag">{tag}</span>)}
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </section>
  </div>
</section>

<style>
  .work {
    background: var(--paper);
  }

  .work-head {
    display: grid;
    grid-template-columns: minmax(12rem, 0.7fr) minmax(20rem, 1fr) auto;
    align-items: end;
    gap: 2rem;
    padding-bottom: clamp(2.5rem, 5vw, 4rem);
    border-bottom: 1px solid var(--line-strong);
  }

  .work-head > p {
    max-width: 34rem;
    margin: 0;
    color: var(--ink-soft);
  }

  .count {
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.6rem;
    letter-spacing: 0.12em;
    line-height: 1.55;
    text-align: right;
  }

  .cases {
    display: grid;
  }

  .case {
    display: grid;
    grid-template-columns: minmax(0, 1.45fr) minmax(19rem, 0.75fr);
    align-items: center;
    gap: clamp(2rem, 6vw, 6rem);
    padding: clamp(3rem, 7vw, 6rem) 0;
    border-bottom: 1px solid var(--line-strong);
  }

  .case:nth-child(even) {
    grid-template-columns: minmax(19rem, 0.75fr) minmax(0, 1.45fr);
  }

  .case:nth-child(even) .case-media {
    grid-column: 2;
    grid-row: 1;
  }

  .case:nth-child(even) .case-body {
    grid-column: 1;
    grid-row: 1;
  }

  .case-media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    color: inherit;
    background: var(--dark);
    text-decoration: none;
  }

  .case-media::after,
  .system-media::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 1px solid rgba(17, 19, 15, 0.08);
    pointer-events: none;
  }

  video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 700ms var(--ease);
  }

  .case:hover video,
  .system-card:hover video {
    transform: scale(1.025);
  }

  .case-no {
    position: absolute;
    z-index: 1;
    right: 0.85rem;
    bottom: 0.85rem;
    min-width: 2.25rem;
    padding: 0.4rem;
    color: var(--dark);
    background: var(--signal);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-align: center;
  }

  .architecture {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(0.35rem, 1.5vw, 1.1rem);
    height: 100%;
    padding: 2rem;
    color: var(--paper);
    background:
      linear-gradient(rgba(212, 242, 92, 0.055) 1px, transparent 1px),
      linear-gradient(90deg, rgba(212, 242, 92, 0.055) 1px, transparent 1px),
      var(--dark);
    background-size: 28px 28px;
  }

  .architecture span {
    padding: 0.55rem 0.65rem;
    border: 1px solid rgba(245, 244, 237, 0.28);
    font-family: var(--font-mono);
    font-size: clamp(0.52rem, 0.8vw, 0.68rem);
    text-align: center;
  }

  .architecture i {
    color: var(--signal);
    font-style: normal;
  }

  .case-body {
    display: flex;
    align-items: flex-start;
    flex-direction: column;
  }

  .role {
    margin: 0;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .case h3 {
    margin: 0.9rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4vw, 4.3rem);
    font-weight: 720;
    letter-spacing: -0.055em;
    line-height: 0.94;
  }

  .case h3 a {
    text-decoration: none;
  }

  .summary {
    margin: 1.35rem 0 0;
    color: var(--ink-soft);
    font-size: 0.98rem;
    line-height: 1.66;
  }

  .proofs {
    display: grid;
    gap: 0.4rem;
    width: 100%;
    margin: 1.5rem 0 0;
    padding: 1rem 0 0;
    border-top: 1px solid var(--line);
    color: var(--ink-soft);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    list-style: none;
  }

  .proofs li::before {
    content: '↳';
    margin-right: 0.55rem;
    color: var(--accent);
  }

  .case-foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    margin-top: 1.5rem;
  }

  .case-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-weight: 680;
    text-decoration: none;
    white-space: nowrap;
  }

  .case-link span {
    color: var(--accent);
  }

  .systems {
    padding: clamp(4rem, 8vw, 7rem) 0 0;
  }

  .systems-head {
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: end;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .systems-head h3 {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.9rem, 3.6vw, 3rem);
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .systems-head > p {
    max-width: 32rem;
    margin: 0;
    color: var(--ink-soft);
  }

  .systems-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    background: var(--line-strong);
    border: 1px solid var(--line-strong);
  }

  .system-card {
    min-width: 0;
    background: var(--paper);
  }

  .system-media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--dark);
  }

  .system-media > span {
    position: absolute;
    z-index: 1;
    right: 0.65rem;
    bottom: 0.55rem;
    color: var(--paper);
    font-family: var(--font-mono);
    font-size: 0.58rem;
  }

  .tool-placeholder {
    display: grid;
    place-content: center;
    gap: 0.45rem;
    height: 100%;
    color: var(--paper);
    background:
      linear-gradient(135deg, rgba(212, 242, 92, 0.12), transparent 50%),
      var(--dark);
    font-family: var(--font-display);
    text-align: center;
  }

  .tool-placeholder small {
    color: var(--signal);
    font-family: var(--font-mono);
    font-size: 0.5rem;
    letter-spacing: 0.08em;
  }

  .system-body {
    padding: 1.2rem;
  }

  .system-body h4 {
    margin: 0.5rem 0 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    letter-spacing: -0.025em;
  }

  .system-body > p:not(.role) {
    min-height: 4.2em;
    margin: 0.65rem 0 1rem;
    color: var(--ink-soft);
    font-size: 0.84rem;
    line-height: 1.5;
  }

  @media (max-width: 980px) {
    .work-head {
      grid-template-columns: 1fr 1fr;
    }

    .count {
      display: none;
    }

    .systems-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .work-head,
    .systems-head {
      grid-template-columns: 1fr;
      gap: 1rem;
    }

    .case,
    .case:nth-child(even) {
      grid-template-columns: 1fr;
      gap: 1.6rem;
    }

    .case:nth-child(even) .case-media,
    .case:nth-child(even) .case-body {
      grid-column: auto;
      grid-row: auto;
    }

    .case h3 {
      font-size: clamp(2.35rem, 12vw, 3.8rem);
    }

    .summary {
      margin-top: 1rem;
    }
  }

  @media (max-width: 520px) {
    .systems-grid {
      grid-template-columns: 1fr;
    }

    .system-body > p:not(.role) {
      min-height: 0;
    }

    .case-foot {
      align-items: flex-start;
      flex-direction: column;
    }

    .architecture {
      padding: 1rem;
    }
  }
</style>
