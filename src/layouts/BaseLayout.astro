---
import '../styles/global.css';
import type { Locale } from '../content/site';

type Props = {
  locale: Locale;
  title: string;
  description: string;
  alternateZhPath?: string;
  alternateEnPath?: string;
};

const { locale, title, description, alternateZhPath = '/', alternateEnPath = '/en/' } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const alternateZh = new URL(alternateZhPath, Astro.site).toString();
const alternateEn = new URL(alternateEnPath, Astro.site).toString();
---

<!doctype html>
<html lang={locale === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#11130f" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh-CN" href={alternateZh} />
    <link rel="alternate" hreflang="en" href={alternateEn} />
    <link rel="alternate" hreflang="x-default" href={alternateZh} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500..800&family=IBM+Plex+Mono:wght@400;500&family=Source+Sans+3:ital,wght@0,400..700;1,400..700&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#content">{locale === 'zh' ? '跳到主要内容' : 'Skip to content'}</a>
    <slot />
    <script>
      const videos = document.querySelectorAll('[data-lazy-video]');
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      if (!reduceMotion && 'IntersectionObserver' in window) {
        const videoObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              const video = entry.target as HTMLVideoElement;

              if (entry.isIntersecting) {
                if (video.readyState < 2) {
                  video.load();
                }

                video.play().catch(() => {});
              } else {
                video.pause();
              }
            });
          },
          { threshold: 0.22, rootMargin: '120px 0px' },
        );

        videos.forEach((video) => videoObserver.observe(video));
      } else {
        videos.forEach((video) => (video as HTMLVideoElement).pause());
      }
    </script>
  </body>
</html>
